# Genera un valor largo y aleatorio distinto en cada computadora.
SECRET_KEY=cambia-este-valor
# En Linux, PostgreSQL usará un rol con el mismo nombre que tu usuario local.
DATABASE_URL=postgresql:///mantenimiento_predictivo?host=/var/run/postgresql
# Activa esta opción cuando la aplicación se publique con HTTPS.
SESSION_COOKIE_SECURE=false
